    "@valibot/i18n": "^1.1.0",
    "@xmldom/xmldom": "^0.8.11",
    "big.js": "^7.0.1",
    "fflate": "^0.8.2",
    "luxon": "^3.7.2",
    "node-forge": "^1.3.3",
    "soap": "^1.6.3",
    "valibot": "^1.3.1",
    "xml-crypto": "^6.1.2",
    "xmlbuilder2": "^4.0.3"
  },
  "inlinedDependencies": {
    "type-fest": "5.5.0"
