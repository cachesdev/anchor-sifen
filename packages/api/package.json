{
  "name": "@anchorsoft/sifen",
  "version": "0.1.1",
  "description": "Cliente TypeScript para SIFEN. genera, firma, envía y consulta Documentos Electrónicos (DE) del sistema de facturación electrónica de Paraguay SIFEN",
  "keywords": [
    "sifen",
    "paraguay",
    "factura-electronica",
    "set",
    "dnit",
    "xml",
    "firma-digital",
    "documento-electronico",
    "facturacion"
  ],
  "type": "module",
  "author": "Anchor Software - Gustavo Dominguez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cachesdev/anchor-sifen.git"
  },
  "bugs": {
    "url": "https://github.com/cachesdev/anchor-sifen/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "test": "vitest",
    "check": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@apidevtools/json-schema-ref-parser": "^15.3.1",
    "@eslint/compat": "^2.0.1",
    "@eslint/js": "^9.39.2",
