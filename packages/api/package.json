    "@types/big.js": "^6.2.2",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24",
    "@types/node-forge": "^1.3.14",
    "@types/xml-crypto": "^1.4.6",
    "@types/xmldom": "^0.1.34",
    "@vitest/coverage-v8": "4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "exceljs": "^4.4.0",
    "globals": "^17.0.0",
    "jiti": "^2.6.1",
    "prettier": "^3.8.0",
    "tsdown": "^0.21.4",
    "tsx": "^4.21.0",
    "type-fest": "^5.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.53.0",
    "vite-bundle-explorer": "^1.0.0",
    "vitest": "^4.0.16"
  },
  "files": [
